        "not_downloaded",
        "in_progress",
        "uploaded",
        "cancelled",
        "uploading"
      ],
      "choice_labels": {
        "pending": "függőben",
        "not_downloaded": "nincs letöltve",
        "in_progress": "folyamatban",
        "uploaded": "feltöltött / kész",
        "cancelled": "megszakított / törölt",
        "uploading": "feltöltés alatt"
      }
    },
    {
      "name": "start",
      "label": "Kezdés (mikor indították)",
      "type": "datetime",
      "presets": [
        "today",
        "last_2_days",
        "last_7_days",
        "last_30_days",
        "last_year"
      ],
      "preset_labels": {
        "today": "ma",
        "last_2_days": "utóbbi 2 nap",
