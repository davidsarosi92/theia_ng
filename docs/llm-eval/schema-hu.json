{
  "model_key": "goods.inventorycountheader",
  "verbose_name": "Inventory count header",
  "description": "A single stocktake sheet within a catalog: the count of one Space/category. Its individual counted lines are the InventoryCounts.",
  "filter_fields": [
    {
      "name": "status",
      "label": "Állapot",
      "type": "choice",
