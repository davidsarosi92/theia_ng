        "last_year": "utóbbi év / tavaly óta"
      }
    },
    {
      "name": "finish",
      "label": "Befejezés (mikor zárták le)",
      "type": "datetime",
      "presets": [
        "today",
        "last_2_days",
        "last_7_days",
        "last_30_days",
        "last_year"
      ],
      "preset_labels": {
        "today": "ma",
        "last_2_days": "utóbbi 2 nap",
        "last_7_days": "utóbbi 7 nap / múlt hét",
        "last_30_days": "utóbbi 30 nap / múlt hónap",
        "last_year": "utóbbi év / tavaly óta"
      }
    }
  ],
  "search_description": "Free text is matched against: the starting user's name and their integration name, external_key1, external_key2, and the space / house / company / registration names. (magyarul: helyszín, ház, cég, regisztráció neve, vagy a leltárt indító személy neve)",
  "ordering_fields": [
    "pk",
