# Copy to .env and adjust.  cp .env.example .env

# Which model to serve. qwen2.5:7b is the measured pick — see docs/llm-eval.
# Do NOT pick by parameter count: llama3.1:8b is bigger and scored far worse.
# Do NOT pick a reasoning model (qwen3:8b): accurate but ~11 s per request.
THEIA_LLM_MODEL=qwen2.5:7b

# Where Ollama keeps its models. Defaults to your existing ~/.ollama so anything
# you already pulled is reused. Use an absolute path.
OLLAMA_DATA=${HOME}/.ollama

OLLAMA_PORT=11434
OLLAMA_KEEP_ALIVE=10m
OLLAMA_NUM_PARALLEL=1
